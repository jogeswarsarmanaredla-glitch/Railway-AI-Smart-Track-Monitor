# ==============================================================================
# Railway AI - Smart Track Monitoring Environment Configuration
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DATA_SOURCE=SYNTHETIC_SIMULATION_ENGINE
LOG_LEVEL=info

# CORS - Allowed Frontend Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENVIRONMENT=SIMULATION_BENCHMARK

# ==============================================================================
# Database Configuration (PostgreSQL 18.6 + SQLAlchemy 2.0 + Psycopg 3)
# ==============================================================================
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=railway_ai

# Optional Complete Connection URI (Overrides individual variables if specified):
# DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/railway_ai

# Strict Fallback Policy (Default: false)
ALLOW_SQLITE_FALLBACK=false
